CXX_STD = CXX17
PKG_CPPFLAGS = -I../inst/include

# -Wa,-mbig-obj selects the bigobj COFF variant, whose section count is bounded
# by 2^31 instead of the 32767 a plain COFF object holds. gcc emits one comdat
# section per template instantiation and merges none of them at -O0, so a build
# that does not optimize (pkgbuild::compile_dll(debug = TRUE), the path
# devtools::load_all() takes) needs it. An optimizing build does not get it:
# R CMD check reports -Wa,-mbig-obj as a non-portable flag whenever a compile
# command carries it. gcc obeys the LAST -O flag on the command line, and a
# debug build appends -O0 to a CXXFLAGS that already holds Makeconf's -O2, so
# the test reads only the last -O flag in CXXFLAGS. It is expanded when a
# compile rule runs, after Makeconf and any user Makevars have been read.
comma := ,
BIGOBJ_FLAG = $(if $(filter -O1 -O2 -O3 -Os -Ofast,$(lastword $(filter -O%,$(CXXFLAGS)))),,-Wa$(comma)-mbig-obj)
PKG_CXXFLAGS = $(SHLIB_OPENMP_CXXFLAGS) $(BIGOBJ_FLAG)
PKG_LIBS = $(SHLIB_OPENMP_CXXFLAGS) $(LAPACK_LIBS) $(BLAS_LIBS) $(FLIBS)
