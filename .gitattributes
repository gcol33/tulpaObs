* text=auto eol=lf

# Build scripts are run by sh/make on Unix, which fails on CRLF.
src/Makevars     text eol=lf
src/Makevars.win text eol=lf

# cmd.exe reads batch files as CRLF.
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary, never line-ending converted and never diffed as text.
*.rda binary
*.rds binary
*.RData binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.pdf binary
*.ttf binary
*.woff binary
*.woff2 binary
*.zip binary
*.gz binary
