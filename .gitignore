# R build artifacts
src/*.o
src/*.dll
src/*.so
src/*.dylib
src/*.gch

# R package build
*.Rcheck/
*.tar.gz
Rplots.pdf
figure/

# IDE
.Rhistory
.RData
.Rproj.user

# Claude Code local state (lock files, machine-local settings)
.claude/

# Temp
test_*.R
run_*.R
_*.R
_*.txt
_*/

# dev_notes/ holds ad-hoc probes, reproducers, and math derivations that stay
# local and never reach the remote (a handful of tracked exceptions predate
# this rule). A comment in R/, man/, vignettes, or tests must not cite a
# dev_notes/ path as its backing -- inline the content instead.
dev_notes/

# Local output of the sharded full-recovery tier (.github/scripts/run-tests.R
# writes per-shard results, aggregate-tier3.R collects them into a timings CSV).
# The CI workflow moves these through artifacts; a local run leaves them here.
tier3-out/
tier3-artifacts/
tier3-timings.csv

# knitr's own build output -- regenerated every vignette build, not the source.
vignettes/*_files/
vignettes/*.html
