# R build artifacts
src/*.o
src/*.dll
src/*.so
src/*.dylib
src/*.gch

# R package build
*.Rcheck/
*.tar.gz
Rplots.pdf
figure/

# IDE
.Rhistory
.RData
.Rproj.user

# Claude Code local state (lock files, machine-local settings)
.claude/

# Temp
test_*.R
run_*.R
_*.R
_*.txt
_*/

# dev_notes/ contains math derivations and probe scripts referenced from
# R/, man/, vignettes, and tests — override the global gitignore rule
# (including overriding *.log etc. for files inside dev_notes/).
!dev_notes/
!dev_notes/**

# Ad-hoc probes, reproducers, build/test logs (kept in-tree, not committed)
dev_notes/
